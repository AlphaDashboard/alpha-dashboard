# =============================================================================
# Alpha Dashboard — PostgreSQL Trial Environment Configuration
# =============================================================================
#
# PURPOSE: Switch from SQLite3 to PostgreSQL for Subsection B2 trial.
#
# HOW TO USE:
#   1. Copy this file and rename it to ".env" in the project root
#   2. Fill in the actual values below
#   3. The Django settings.py will automatically read these values
#   4. Run: python manage.py migrate
#
# WARNING: Never commit the real .env file to version control.
#          This .env.postgresql file is a safe template (no real passwords).
# =============================================================================

# ── Database Engine ──────────────────────────────────────────────────────────
# Switch from SQLite to PostgreSQL by changing this one line.
# Leave as sqlite3 to revert to SQLite at any time (rollback).
DB_ENGINE=django.db.backends.postgresql

# ── PostgreSQL Connection ─────────────────────────────────────────────────────
DB_NAME=alpha_dashboard_trial
DB_USER=alpha_user
DB_PASSWORD=YourStrongPasswordHere
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# TO ROLLBACK TO SQLITE — simply comment out all lines above and set:
# DB_ENGINE=django.db.backends.sqlite3
# (or delete this .env file entirely — SQLite is the default)
# =============================================================================
